
class Solution {
    public boolean isSubset(int a[], int b[]) {
        // Your code here
        Arrays.sort(a);
        Arrays.sort(b);
       int count=0;
       int left=0;
       for(int i=0;i<a.length;i++){
           if(a[i]==b[left]){
               count++;
               left++;
           }
           if(count==b.length){
           return true;
       }
       }
           
           return false;
    }
}
